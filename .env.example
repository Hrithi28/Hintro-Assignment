# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI Provider: Groq (free tier — get key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Discord Webhook for reminders
# Create one: Discord Server → Channel → Edit → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Reminder schedule (cron format, default: 9 AM daily)
REMINDER_CRON=0 9 * * *

# Evaluation metadata
CANDIDATE_NAME=Your Name
CANDIDATE_EMAIL=you@example.com
REPO_URL=https://github.com/yourusername/hintro
DEPLOYED_URL=https://your-deployment-url.com
